
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JARVIS AI - Version 2.0</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  padding: 25px 15px;
  background: radial-gradient(circle, #102b45, #030914 75%);
  color: #e5faff;
  font-family: Arial, sans-serif;
  text-align: center;
}

h1 {
  color: #00d9ff;
  font-size: 38px;
  letter-spacing: 6px;
  text-shadow: 0 0 20px #00d9ff;
  margin-bottom: 5px;
}

.version {
  color: #8aaebe;
  font-size: 12px;
  letter-spacing: 3px;
}

.reactor {
  width: 175px;
  height: 175px;
  border: 3px solid #00d9ff;
  border-radius: 50%;
  margin: 35px auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 65px;
  color: #00d9ff;
  box-shadow: 0 0 25px #008cff,
              inset 0 0 25px #008cff;
  animation: glow 2s infinite alternate;
}

@keyframes glow {
  from { box-shadow: 0 0 15px #008cff; }
  to { box-shadow: 0 0 40px #00d9ff; }
}

.panel {
  max-width: 480px;
  margin: auto;
  padding: 22px;
  border: 1px solid #087fa5;
  border-radius: 18px;
  background: rgba(7, 25, 43, .9);
}

#status {
  color: #00e6ff;
  font-weight: bold;
  min-height: 24px;
}

#result {
  background: #071321;
  border: 1px solid #17445d;
  border-radius: 12px;
  min-height: 90px;
  padding: 18px;
  margin: 18px 0;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

button {
  width: 100%;
  padding: 14px;
  margin: 7px 0;
  border: none;
  border-radius: 10px;
  background: #00c9ef;
  color: #00131d;
  font-weight: bold;
  font-size: 15px;
}

button:active {
  transform: scale(.98);
}

input {
  width: 100%;
  padding: 14px;
  margin: 12px 0;
  border-radius: 10px;
  border: 1px solid #00d9ff;
  background: #071321;
  color: white;
  font-size: 16px;
}

.small {
  color: #7896a8;
  font-size: 12px;
  margin-top: 20px;
}
</style>
</head>

<body>

<h1>J.A.R.V.I.S</h1>
<p class="version">PERSONAL AI ASSISTANT • VERSION 2.0</p>

<div class="reactor">◉</div>

<div class="panel">

<h3 id="status">SYSTEM READY</h3>

<div id="result">
Hello Sir! I am JARVIS. How can I help you?
</div>

<button onclick="testVoice()">TEST SPEAKER</button>
<button onclick="testMic()">TEST MICROPHONE</button>
<button onclick="startListening()">🎤 START LISTENING</button>
<button onclick="stopListening()">STOP</button>

<input id="commandInput"
placeholder="Type your command here...">

<button onclick="sendCommand()">SEND COMMAND</button>

<p class="small">
JARVIS AI • Voice Engine 2.0
</p>

</div>

<script>
const statusBox = document.getElementById("status");
const resultBox = document.getElementById("result");
const inputBox = document.getElementById("commandInput");

let recognition = null;
let listening = false;

function speak(message) {
  resultBox.textContent = message;

  if (!("speechSynthesis" in window)) {
    statusBox.textContent = "SPEAKER NOT SUPPORTED";
    return;
  }

  window.speechSynthesis.cancel();

  const voice = new SpeechSynthesisUtterance(message);
  voice.lang = "hi-IN";
  voice.rate = 0.9;
  voice.pitch = 0.85;
  voice.volume = 1;

  voice.onstart = () => {
    statusBox.textContent = "JARVIS SPEAKING...";
  };

  voice.onend = () => {
    statusBox.textContent = "SYSTEM READY";
  };

  voice.onerror = () => {
    statusBox.textContent = "SPEAKER ERROR";
  };

  window.speechSynthesis.speak(voice);
}

function testVoice() {
  speak("Yes Sir! JARVIS voice system is working.");
}

async function testMic() {
  if (!navigator.mediaDevices ||
      !navigator.mediaDevices.getUserMedia) {
    statusBox.textContent = "MICROPHONE NOT AVAILABLE";
    return;
  }

  try {
    const stream =
      await navigator.mediaDevices.getUserMedia({
        audio: true
      });

    stream.getTracks().forEach(track => track.stop());

    statusBox.textContent = "MICROPHONE WORKING";
    resultBox.textContent =
      "Sir, microphone permission granted.";
  } catch (error) {
    statusBox.textContent =
      "MICROPHONE ERROR: " + error.name;
  }
}

function createRecognition() {
  const Speech =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if (!Speech) {
    statusBox.textContent =
      "VOICE RECOGNITION NOT SUPPORTED";
    return false;
  }

  recognition = new Speech();
  recognition.lang = "hi-IN";
  recognition.continuous = false;
  recognition.interimResults = false;

  recognition.onstart = () => {
    listening = true;
    statusBox.textContent = "LISTENING...";
  };

  recognition.onresult = event => {
    const command =
      event.results[0][0].transcript;

    resultBox.textContent = "YOU: " + command;
    processCommand(command);
  };

  recognition.onerror = event => {
    listening = false;
    statusBox.textContent =
      "VOICE ERROR: " + event.error;
  };

  recognition.onend = () => {
    listening = false;

    if (statusBox.textContent === "LISTENING...") {
      statusBox.textContent = "SYSTEM READY";
    }
  };

  return true;
}

function startListening() {
  if (!recognition) {
    if (!createRecognition()) return;
  }

  if (listening) return;

  try {
    recognition.start();
  } catch (error) {
    statusBox.textContent = "PLEASE TRY AGAIN";
  }
}

function stopListening() {
  if (recognition && listening) {
    recognition.stop();
  }

  window.speechSynthesis.cancel();
  listening = false;
  statusBox.textContent = "JARVIS STOPPED";
}

function processCommand(command) {
  const text = command.toLowerCase().trim();

  if (
    text.includes("hello") ||
    text.includes("हेलो") ||
    text.includes("नमस्ते") ||
    text.includes("jarvis")
  ) {
    speak("Yes Sir! How can I help you?");
  }

  else if (
    text.includes("समय") ||
    text.includes("time")
  ) {
    const time = new Date().toLocaleTimeString("hi-IN");
    speak("Sir, abhi samay hai " + time);
  }

  else if (
    text.includes("नाम") ||
    text.includes("name")
  ) {
    speak("Sir, I am JARVIS, your personal AI assistant.");
  }

  else if (
    text.includes("कैसे हो") ||
    text.includes("how are you")
  ) {
    speak("I am functioning perfectly, Sir.");
  }

  else if (
    text.includes("धन्यवाद") ||
    text.includes("thank you")
  ) {
    speak("You are welcome, Sir.");
  }

  else if (
    text.includes("बंद") ||
    text.includes("stop")
  ) {
    speak("Okay Sir.");
  }

  else {
    speak("I heard you, Sir. I do not know this command yet.");
  }
}

function sendCommand() {
  const command = inputBox.value.trim();

  if (!command) return;

  resultBox.textContent = "YOU: " + command;
  inputBox.value = "";
  processCommand(command);
}

inputBox.addEventListener("keydown", event => {
  if (event.key === "Enter") {
    sendCommand();
  }
});
</script>

</body>
</html>

