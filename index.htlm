
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JARVIS AI Assistant</title>

<style>
body {
  margin: 0;
  padding: 25px 15px;
  background: #050b18;
  color: #00d9ff;
  font-family: Arial, sans-serif;
  text-align: center;
}

h1 {
  font-size: 38px;
  letter-spacing: 5px;
  margin-top: 35px;
  text-shadow: 0 0 20px #00d9ff;
}

.circle {
  width: 160px;
  height: 160px;
  border: 3px solid #00d9ff;
  border-radius: 50%;
  margin: 35px auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60px;
  box-shadow: 0 0 30px #008cff;
}

button {
  background: #00bde9;
  border: none;
  padding: 14px 22px;
  margin: 8px;
  border-radius: 25px;
  font-size: 15px;
  font-weight: bold;
  color: #00121b;
}

#status, #result {
  margin: 20px auto;
  max-width: 450px;
  padding: 12px;
  color: white;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

input {
  padding: 13px;
  width: 70%;
  border-radius: 20px;
  border: 1px solid #00d9ff;
  background: #101c30;
  color: white;
}
</style>
</head>

<body>

<h1>J.A.R.V.I.S</h1>
<p>PERSONAL AI ASSISTANT</p>

<div class="circle">◉</div>

<h3 id="status">System Ready</h3>

<button onclick="testMic()">TEST MICROPHONE</button>
<button onclick="startListening()">START LISTENING</button>
<button onclick="stopListening()">STOP</button>

<div id="result">Hello Sir! I am JARVIS.</div>

<br>

<input id="textInput" placeholder="Type your command...">
<button onclick="sendText()">SEND</button>

<script>

const statusText = document.getElementById("status");
const result = document.getElementById("result");

let recognition = null;

function speak(message) {
  result.textContent = message;

  if (!("speechSynthesis" in window)) {
    statusText.textContent = "Voice output not supported";
    return;
  }

  window.speechSynthesis.cancel();

  const speech = new SpeechSynthesisUtterance(message);
  speech.lang = "hi-IN";
  speech.rate = 0.9;
  speech.pitch = 0.85;
  speech.volume = 1;

  window.speechSynthesis.speak(speech);
}

async function testMic() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      audio: true
    });

    stream.getTracks().forEach(track => track.stop());
    statusText.textContent = "Microphone Working!";
  } catch (error) {
    statusText.textContent = "Microphone Error: " + error.name;
  }
}

function setupRecognition() {
  const Speech =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if (!Speech) {
    statusText.textContent =
      "Voice recognition not supported. Try Chrome.";
    return false;
  }

  recognition = new Speech();
  recognition.lang = "hi-IN";
  recognition.continuous = false;
  recognition.interimResults = false;

  recognition.onstart = function() {
    statusText.textContent = "Listening...";
  };

  recognition.onresult = function(event) {
    const command = event.results[0][0].transcript;
    result.textContent = "You said: " + command;
    processCommand(command);
  };

  recognition.onerror = function(event) {
    statusText.textContent = "Voice Error: " + event.error;
  };

  recognition.onend = function() {
    if (statusText.textContent === "Listening...") {
      statusText.textContent = "System Ready";
    }
  };

  return true;
}

function startListening() {
  if (!recognition) {
    if (!setupRecognition()) return;
  }

  try {
    recognition.start();
  } catch (error) {
    statusText.textContent = "Please wait and try again.";
  }
}

function stopListening() {
  if (recognition) {
    recognition.stop();
  }

  window.speechSynthesis.cancel();
  statusText.textContent = "JARVIS Stopped";
}

function processCommand(command) {
  const text = command.toLowerCase();

  if (text.includes("hello") ||
      text.includes("हेलो") ||
      text.includes("नमस्ते") ||
      text.includes("jarvis")) {

    speak("Yes Sir! How can I help you?");

  } else if (text.includes("समय") ||
             text.includes("time")) {

    const time = new Date().toLocaleTimeString("hi-IN");
    speak("Sir, abhi samay hai " + time);

  } else if (text.includes("नाम") ||
             text.includes("name")) {

    speak("Sir, I am JARVIS, your personal AI assistant.");

  } else if (text.includes("कैसे हो") ||
             text.includes("how are you")) {

    speak("I am functioning perfectly, Sir.");

  } else if (text.includes("धन्यवाद") ||
             text.includes("thank you")) {

    speak("You are welcome, Sir.");

  } else {

    speak("I heard you, Sir. I am still learning this command.");

  }
}

function sendText() {
  const input = document.getElementById("textInput");
  const command = input.value.trim();

  if (command !== "") {
    processCommand(command);
    input.value = "";
  }
}

document.getElementById("textInput")
.addEventListener("keydown", function(event) {
  if (event.key === "Enter") {
    sendText();
  }
});

</script>
</body>
</html>

